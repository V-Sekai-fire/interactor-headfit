/-!
# `RotationStar.Slang.SwingTwist` — the swing-twist split, one thread per rotation

`RotationStar.SwingTwist.swingTwist` in Slang (`Split.swingTwistAngle`): for rotation `i` and
its coordinate axis, the swing `R0`, the twist `T = R0ᵀ R` and the twist angle.

Bindings (set 0):

   0  ConstantBuffer<SwingTwistParams> { uint N; }
   1  StructuredBuffer<float>   rot    (N·9)  row-major
   2  StructuredBuffer<uint>    axis   (N)    0 = x, 1 = y, 2 = z
   3  RWStructuredBuffer<float> swing  (N·9)
   4  RWStructuredBuffer<float> twist  (N·9)
   5  RWStructuredBuffer<float> angle  (N)
-/

namespace RotationStar.Slang.SwingTwist

open LeanSlang
open RotationStar.Slang.Dsl
open RotationStar.Slang.Split

def body : List St :=
  [ let_ uT "i" (.member (v "tid") "x")
  , if_ (ge (v "i") (p "N")) [ret] ] ++
  load9 "R" "rot" (v "i" * u 9) ++
  [ let_ uT "ax" (at_ "axis" (v "i")) ] ++
  swingTwistAngle "st" "R" (v "ax") ++
  store9 "swing" (v "i" * u 9) "st_R0" ++
  store9 "twist" (v "i" * u 9) "st_T" ++
  [ setAt "angle" (v "i") (v "st") ]

def shader : SlangShaderModule :=
  { structs := [ { name := "SwingTwistParams", fields := [fld "N" uT] } ]
  , globals := [ paramsCB "SwingTwistParams", roF "rot" 1, roU "axis" 2, rwF "swing" 3
               , rwF "twist" 4, rwF "angle" 5 ]
  , functions := [ entry 64 [dtid] body ] }

